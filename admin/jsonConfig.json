{
  "type": "tabs",
  "items": {
    "server": {
      "type": "panel",
      "label": "server.label",
      "items": {
        "_serverIntro": {
          "type": "staticText",
          "label": "server._serverIntro.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "publicBaseUrl": {
          "type": "text",
          "label": "server.publicBaseUrl.label",
          "sm": 12,
          "validator": "!data.publicBaseUrl || /^https:\\/\\/[^\\s/?#]+\\/?$/.test(data.publicBaseUrl)",
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_urlHelp": {
          "type": "staticText",
          "label": "server._urlHelp.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_providerUrl": {
          "type": "pattern",
          "label": "server._providerUrl.label",
          "pattern": "${data.publicBaseUrl}/provider/",
          "copyToClipboard": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_oauthUrl": {
          "type": "pattern",
          "label": "server._oauthUrl.label",
          "pattern": "${data.publicBaseUrl}/oauth/authorize",
          "copyToClipboard": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_tokenUrl": {
          "type": "pattern",
          "label": "server._tokenUrl.label",
          "pattern": "${data.publicBaseUrl}/oauth/token",
          "copyToClipboard": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "bind": {
          "type": "text",
          "label": "server.bind.label",
          "sm": 6,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "port": {
          "type": "number",
          "label": "server.port.label",
          "sm": 6,
          "min": 1,
          "max": 65535,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "trustProxy": {
          "type": "checkbox",
          "label": "server.trustProxy.label",
          "help": "server.trustProxy.help",
          "sm": 12,
          "default": false,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "oauth": {
      "type": "panel",
      "label": "oauth.label",
      "items": {
        "_oauthHelp": {
          "type": "staticText",
          "label": "oauth._oauthHelp.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "oauthClientId": {
          "type": "text",
          "label": "oauth.oauthClientId.label",
          "sm": 6,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "oauthClientSecret": {
          "type": "password",
          "label": "oauth.oauthClientSecret.label",
          "sm": 6,
          "visible": true,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "oauthLogin": {
          "type": "text",
          "label": "oauth.oauthLogin.label",
          "sm": 6,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "oauthPassword": {
          "type": "password",
          "label": "oauth.oauthPassword.label",
          "sm": 6,
          "visible": true,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "oauthUserId": {
          "type": "text",
          "label": "oauth.oauthUserId.label",
          "sm": 6,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "_createOAuth": {
          "type": "sendTo",
          "label": "oauth._createOAuth.label",
          "command": "jsonOAuthBootstrap",
          "useNative": true,
          "showProcess": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_rotateLogin": {
          "type": "sendTo",
          "label": "oauth._rotateLogin.label",
          "command": "jsonOAuthRotatePassword",
          "useNative": true,
          "showProcess": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_oauthNote": {
          "type": "staticText",
          "label": "oauth._oauthNote.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "callbacks": {
      "type": "panel",
      "label": "callbacks.label",
      "items": {
        "callbackEnabled": {
          "type": "checkbox",
          "label": "callbacks.callbackEnabled.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "callbackSkillId": {
          "type": "text",
          "label": "callbacks.callbackSkillId.label",
          "sm": 6,
          "hidden": "!data.callbackEnabled",
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "callbackOauthToken": {
          "type": "password",
          "label": "callbacks.callbackOauthToken.label",
          "sm": 6,
          "hidden": "!data.callbackEnabled",
          "visible": true,
          "xs": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "debugActions": {
          "type": "checkbox",
          "label": "callbacks.debugActions.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_callbackInfo": {
          "type": "staticText",
          "label": "callbacks._callbackInfo.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "devices": {
      "type": "panel",
      "label": "devices.label",
      "items": {
        "_deviceInfo": {
          "type": "staticText",
          "label": "devices._deviceInfo.label",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_github": {
          "type": "staticLink",
          "label": "devices._github.label",
          "href": "https://github.com/mastergt/ioBroker.yandex-ud-bridge",
          "button": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
  },
  "i18n": true
}
